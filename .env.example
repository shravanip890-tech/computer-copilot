# Copy this file to .env and fill in values for your local machine.
# Never commit your real .env file or secrets.
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-6-luna

# Optional: only needed if you use MySQL-backed face registration.
MYSQL_HOST=localhost
MYSQL_USER=computer_copilot
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=computer_copilot
